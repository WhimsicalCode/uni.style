{:deps {:aliases [:cljs]}
 :dev-http {8091 "public"}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn example.core/init!}}
                :build-hooks [(uni.style.build/hook)]
                :css-options {:output-to "public/css/bundle.css"}
                :devtools {:after-load example.core/reload!}}}}
